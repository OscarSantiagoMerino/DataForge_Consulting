/// Tabla de medidas DAX oficiales del sistema de métricas.
table Medidas
	lineageTag: c6ec0a68-3de3-5ed4-9aac-f2ac52b6f78a

	/// Clientes únicos en el contexto de filtro.
	measure Clientes = DISTINCTCOUNT ( fact_clientes[customer_id] )
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 94f7ac10-41b1-5e4b-b2de-c0f7e1eb3eac

	/// Clientes que abandonaron en el período de corte.
	measure 'Clientes Churn' = CALCULATE ( [Clientes], fact_clientes[churn] = 1 )
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 838d2934-5e1b-5bac-8e38-eab27aec9101

	/// Clientes activos al cierre del corte.
	measure 'Clientes Activos' = CALCULATE ( [Clientes], fact_clientes[churn] = 0 )
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: bd4e69d2-1e60-5aaf-aee9-bdff6fae6500

	/// Ingreso recurrente mensual de todos los clientes del corte (USD).
	measure 'MRR Total' = SUM ( fact_clientes[cargo_mensual] )
		formatString: \$#,0
		displayFolder: 1. Base
		lineageTag: 2463145e-6d9b-58da-985e-81d8cb22c167

	/// MRR de los clientes que abandonaron (USD por mes).
	measure 'MRR Perdido' = SUM ( fact_clientes[mrr_perdido] )
		formatString: \$#,0
		displayFolder: 1. Base
		lineageTag: 4e841024-9563-5b98-9c0d-bc4c4c913e9f

	/// MRR de los clientes activos (USD por mes).
	measure 'MRR Activo' = CALCULATE ( [MRR Total], fact_clientes[churn] = 0 )
		formatString: \$#,0
		displayFolder: 1. Base
		lineageTag: a2917923-9ff6-5eac-98bb-f0a4f20a3723

	/// MRR perdido / MRR total del período de corte.
	measure '% MRR Perdido' = DIVIDE ( [MRR Perdido], [MRR Total] )
		formatString: 0.0%
		displayFolder: 2. KPIs estratégicos
		lineageTag: 23cf578a-ce3f-5472-9781-100bd79b9e49

	/// North Star Metric: proporción del MRR que se conserva al cierre del período (1 − MRR perdido / MRR total).
	measure '% MRR Retenido' = IF ( ISBLANK ( [MRR Total] ), BLANK (), 1 - [% MRR Perdido] )
		formatString: 0.0%
		displayFolder: 2. KPIs estratégicos
		lineageTag: ae575fa6-8f85-5b3e-8598-24854e5bb895

	/// Clientes que abandonan / clientes del corte. Tasa del período de corte: no anualizar.
	measure 'Tasa Churn' = DIVIDE ( [Clientes Churn], [Clientes] )
		formatString: 0.0%
		displayFolder: 2. KPIs estratégicos
		lineageTag: 0421f1e2-04a8-563b-8186-a2948f0da525

	/// Clientes con contrato de uno o dos años / clientes.
	measure '% Contrato a Plazo' = DIVIDE ( CALCULATE ( [Clientes], dim_contrato[es_plazo] = 1 ), [Clientes] )
		formatString: 0.0%
		displayFolder: 2. KPIs estratégicos
		lineageTag: 77470361-c64e-52cf-a320-790b0e06f55d

	/// Tasa de churn de clientes con 0 a 6 meses de antigüedad.
	measure 'Churn Temprano 0-6m' = CALCULATE ( [Tasa Churn], dim_antiguedad[banda_antiguedad] = "0–6 m" )
		formatString: 0.0%
		displayFolder: 3. KPIs operativos
		lineageTag: 8a33c31d-8d18-5fb6-88ab-300cf7943230

	/// Clientes con transferencia o tarjeta automática / clientes.
	measure '% Pago Automático' = DIVIDE ( CALCULATE ( [Clientes], dim_pago[es_automatico] = 1 ), [Clientes] )
		formatString: 0.0%
		displayFolder: 3. KPIs operativos
		lineageTag: 8d9fed47-e55c-574f-8677-1b70ac31b1a2

	/// Clientes con internet que tienen seguridad online o soporte técnico / clientes con internet.
	measure 'Adopción Protección' =
			DIVIDE (
			    CALCULATE ( [Clientes], fact_clientes[tiene_internet] = 1, fact_clientes[tiene_proteccion] = 1 ),
			    CALCULATE ( [Clientes], fact_clientes[tiene_internet] = 1 )
			)
		formatString: 0.0%
		displayFolder: 3. KPIs operativos
		lineageTag: 3ba1b48a-67a0-5696-8fba-ee81cb7edca7

	/// Clientes activos con score de churn ≥ 40 %.
	measure 'Clientes Riesgo Alto' = CALCULATE ( [Clientes Activos], fact_clientes[riesgo] = "Alto" )
		formatString: #,0
		displayFolder: 3. KPIs operativos
		lineageTag: c76a8889-623e-5215-9492-773705c8d3db

	/// MRR de los clientes activos de riesgo alto.
	measure 'MRR Riesgo Alto' = CALCULATE ( [MRR Activo], fact_clientes[riesgo] = "Alto" )
		formatString: \$#,0
		displayFolder: 3. KPIs operativos
		lineageTag: 0aee10b7-8a1e-5d3b-ad4d-b3bff0cc6298

	/// Σ probabilidad de churn × cargo mensual de los clientes activos: pérdida esperada si se repiten las tasas del corte.
	measure 'MRR en Riesgo Esperado' =
			VAR v = SUM ( fact_clientes[mrr_riesgo_esperado] )
			RETURN
			    IF ( v > 0, v )
		formatString: \$#,0
		displayFolder: 3. KPIs operativos
		lineageTag: 565362db-2037-56cc-8716-9fc86a745be4

	/// Métrica de balance: MRR / clientes (razón de sumas).
	measure ARPU = DIVIDE ( [MRR Total], [Clientes] )
		formatString: \$#,0.00
		displayFolder: 4. Diagnóstico y balance
		lineageTag: 9c92836a-3523-5177-9b91-58a30ca8cf5d

	/// ARPU de los clientes que abandonaron.
	measure 'ARPU Churners' = DIVIDE ( [MRR Perdido], [Clientes Churn] )
		formatString: \$#,0.00
		displayFolder: 4. Diagnóstico y balance
		lineageTag: 41a225e9-430e-5080-88eb-a2ab3ed8acbf

	/// Participación del segmento en el MRR perdido de la selección.
	measure 'Participación MRR Perdido' = DIVIDE ( [MRR Perdido], CALCULATE ( [MRR Perdido], ALLSELECTED ( fact_clientes ) ) )
		formatString: 0.0%
		displayFolder: 4. Diagnóstico y balance
		lineageTag: 9f1f19c5-2f25-59e9-aaa8-67a5bcec58a1

	/// Odds ratio ajustado del modelo logístico (> 1 aumenta el riesgo).
	measure 'Odds Ratio' = MAX ( drivers_modelo[odds_ratio] )
		formatString: 0.00
		displayFolder: 4. Diagnóstico y balance
		lineageTag: 0efb7883-7ff9-5a9c-b794-1fd12240a6ed

	/// Tasa de churn de la selección sin el filtro de antigüedad: línea de referencia del gráfico de ciclo de vida.
	measure 'Promedio Churn Corte' = CALCULATE ( [Tasa Churn], REMOVEFILTERS ( dim_antiguedad ) )
		formatString: 0.0%
		displayFolder: 4. Diagnóstico y balance
		lineageTag: 3030d502-b4e0-5203-85eb-a337a83de4a3

	/// Semáforo del % MRR retenido: verde ≥ 75 %, amarillo 69.5–75 %, rojo < 69.5 %.
	measure 'Estado NSM' =
			VAR v = ROUND ( [% MRR Retenido], 3 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [% MRR Retenido] ), BLANK (),
			        v >= 0.75, "Verde · en meta",
			        v >= 0.695, "Amarillo · vigilar",
			        "Rojo · crítico"
			    )
		displayFolder: 5. Alertas
		lineageTag: 1e26e1ef-b4cf-5b8d-a066-1e614a47c0b1

	/// Color del semáforo del NSM.
	measure 'Color NSM' =
			VAR v = ROUND ( [% MRR Retenido], 3 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [% MRR Retenido] ), BLANK (),
			        v >= 0.75, "#138a3f",
			        v >= 0.695, "#b07400",
			        "#c8312f"
			    )
		displayFolder: 5. Alertas
		lineageTag: 3f145169-54dd-50cf-bfab-5d5ce5f7a4d5

	/// Semáforo: verde ≤ 45 %, amarillo 45–52.9 %, rojo > 52.9 %.
	measure 'Estado Churn Temprano' =
			VAR v = ROUND ( [Churn Temprano 0-6m], 3 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Churn Temprano 0-6m] ), BLANK (),
			        v <= 0.45, "Verde · en meta",
			        v <= 0.529, "Amarillo · vigilar",
			        "Rojo · crítico"
			    )
		displayFolder: 5. Alertas
		lineageTag: afcb74a7-0abb-5cf9-871d-a10aa6d4b474

	/// Color del semáforo de churn temprano.
	measure 'Color Churn Temprano' =
			VAR v = ROUND ( [Churn Temprano 0-6m], 3 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Churn Temprano 0-6m] ), BLANK (),
			        v <= 0.45, "#138a3f",
			        v <= 0.529, "#b07400",
			        "#c8312f"
			    )
		displayFolder: 5. Alertas
		lineageTag: 3657cf7b-1f29-54d5-83b0-9dad4b0eeff5

	/// Guardrail: verde ≥ USD 64.76, amarillo hasta −3 %, rojo < USD 62.82.
	measure 'Estado ARPU' =
			VAR v = ROUND ( [ARPU], 3 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [ARPU] ), BLANK (),
			        v >= 64.76, "Verde · en meta",
			        v >= 62.82, "Amarillo · vigilar",
			        "Rojo · crítico"
			    )
		displayFolder: 5. Alertas
		lineageTag: 6b1a051f-47d5-596e-b78b-58374a23565b

	/// Color del guardrail de ARPU.
	measure 'Color ARPU' =
			VAR v = ROUND ( [ARPU], 3 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [ARPU] ), BLANK (),
			        v >= 64.76, "#138a3f",
			        v >= 62.82, "#b07400",
			        "#c8312f"
			    )
		displayFolder: 5. Alertas
		lineageTag: 10a87885-77f6-5c25-bc74-c613def9c1a8

	/// Semáforo de la tasa de churn: verde ≤ 22 %, amarillo 22–26.5 %, rojo > 26.5 %.
	measure 'Color Churn' =
			VAR v = ROUND ( [Tasa Churn], 3 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Tasa Churn] ), BLANK (),
			        v <= 0.22, "#138a3f",
			        v <= 0.265, "#b07400",
			        "#c8312f"
			    )
		displayFolder: 5. Alertas
		lineageTag: 4fe3c7bc-b01f-578c-a0dd-d792871533d1

	/// Semáforo del % de contratos a plazo: verde ≥ 50 %, amarillo 45–50 %, rojo < 45 %.
	measure 'Color Plazo' =
			VAR v = ROUND ( [% Contrato a Plazo], 3 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [% Contrato a Plazo] ), BLANK (),
			        v >= 0.5, "#138a3f",
			        v >= 0.45, "#b07400",
			        "#c8312f"
			    )
		displayFolder: 5. Alertas
		lineageTag: 39218d5e-2918-5530-9ef1-4b7516d0b072

	/// Brecha del NSM frente a la meta, en puntos porcentuales.
	measure 'Nota NSM' =
			IF (
			    ISBLANK ( [% MRR Retenido] ),
			    BLANK (),
			    FORMAT ( ( [% MRR Retenido] - 0.75 ) * 100, "+0.0;-0.0" ) & " pp vs. meta 75 %"
			)
		displayFolder: 5. Alertas
		lineageTag: 0e2743c3-d5de-5141-8b19-8d5fbaf4fa35

	/// Contexto de la tarjeta de MRR perdido.
	measure 'Nota MRR Perdido' = FORMAT ( [% MRR Perdido], "0.0%" ) & " del MRR · meta ≤ 25 %"
		displayFolder: 5. Alertas
		lineageTag: 25d242b6-eb87-5804-a61d-df689e515e70

	/// Contexto de la tarjeta de tasa de churn.
	measure 'Nota Churn' = "Meta ≤ 22 % · " & FORMAT ( [Clientes Churn], "#,0" ) & " clientes"
		displayFolder: 5. Alertas
		lineageTag: c32bf1a9-1296-5d2f-abba-a348cc11d111

	/// Contexto de la tarjeta de churn temprano.
	measure 'Nota Churn Temprano' = "Meta ≤ 45 % · 49–72 m: " & FORMAT ( CALCULATE ( [Tasa Churn], dim_antiguedad[banda_antiguedad] = "49–72 m" ), "0.0%" )
		displayFolder: 5. Alertas
		lineageTag: 0af1dd9e-64c8-5db0-ad1b-e8a5bea94c79

	/// Contexto de la tarjeta de contratos a plazo.
	measure 'Nota Plazo' = "Meta ≥ 50 % · palanca L1"
		displayFolder: 5. Alertas
		lineageTag: 02fcebc3-26f2-5aa5-83ed-7ce3d4c7306c

	/// Contexto de la tarjeta de ARPU.
	measure 'Nota ARPU' = "Guardrail: no caer más de 3 %"
		displayFolder: 5. Alertas
		lineageTag: c463e6ec-f8d5-5a77-933e-d1751c9a5f22

	/// Naranja si el grupo supera la tasa de churn de la selección; gris en otro caso.
	measure 'Color Barra Churn' = IF ( [Tasa Churn] > CALCULATE ( [Tasa Churn], ALLSELECTED () ), "#eb6834", "#a9b6c6" )
		displayFolder: 5. Alertas
		lineageTag: 7bfef078-f725-5db5-acdc-a56c226dd26f

	/// Naranja si el factor aumenta el riesgo (OR ≥ 1); azul si lo reduce.
	measure 'Color Odds Ratio' = IF ( [Odds Ratio] >= 1, "#eb6834", "#2a78d6" )
		displayFolder: 5. Alertas
		lineageTag: 5426956d-6a60-543f-a4cb-63cfeb2984fd

	/// Escenario elegido en el segmentador (Base por defecto).
	measure 'Escenario Seleccionado' = SELECTEDVALUE ( dim_escenario[escenario], "Base" )
		displayFolder: 6. Simulador del programa
		lineageTag: 8f2fb75b-73d7-5f73-a329-4cf8bc4dc594

	/// Clientes activos con una palanca asignada.
	measure 'Clientes Objetivo' = CALCULATE ( [Clientes Activos], NOT fact_clientes[palanca_id] IN { "L0", "NA" } )
		formatString: #,0
		displayFolder: 6. Simulador del programa
		lineageTag: 453aa511-690d-5e0f-9e5d-59260b8308d2

	/// Σ prob. de churn × aceptación × reducción atribuible (supuestos del escenario).
	measure 'Clientes Salvados Esperados' =
			VAR esc = [Escenario Seleccionado]
			RETURN
			    SUMX (
			        FILTER ( fact_clientes, fact_clientes[churn] = 0 && NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) ),
			        fact_clientes[prob_churn] * LOOKUPVALUE ( supuestos_escenario[aceptacion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] ) * LOOKUPVALUE ( supuestos_escenario[reduccion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] )
			    )
		formatString: #,0.0
		displayFolder: 6. Simulador del programa
		lineageTag: 1890d613-fca2-5c84-9e6a-e0f8beb9d49b

	/// MRR mensual que se espera conservar con el programa.
	measure 'MRR Salvado Esperado' =
			VAR esc = [Escenario Seleccionado]
			RETURN
			    SUMX (
			        FILTER ( fact_clientes, fact_clientes[churn] = 0 && NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) ),
			        fact_clientes[prob_churn] * fact_clientes[cargo_mensual] * LOOKUPVALUE ( supuestos_escenario[aceptacion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] ) * LOOKUPVALUE ( supuestos_escenario[reduccion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] )
			    )
		formatString: \$#,0
		displayFolder: 6. Simulador del programa
		lineageTag: 7c8d2e72-7d92-5e8b-acdd-e339b295ea41

	/// MRR salvado × margen de contribución × horizonte (meses).
	measure 'Contribución Salvada' =
			VAR esc = [Escenario Seleccionado]
			RETURN
			    SUMX (
			        FILTER ( fact_clientes, fact_clientes[churn] = 0 && NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) ),
			        fact_clientes[prob_churn] * fact_clientes[cargo_mensual] * LOOKUPVALUE ( supuestos_escenario[aceptacion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] ) * LOOKUPVALUE ( supuestos_escenario[reduccion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] )
			            * LOOKUPVALUE ( supuestos_escenario[margen], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] ) * LOOKUPVALUE ( supuestos_escenario[horizonte_meses], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] )
			    )
		formatString: \$#,0
		displayFolder: 6. Simulador del programa
		lineageTag: b7b10fd6-16cd-5ee5-bb32-89b35dc756ba

	/// Costo de contacto + aceptación × incentivo de cada palanca.
	measure 'Costo Programa' =
			VAR esc = [Escenario Seleccionado]
			RETURN
			    SUMX (
			        FILTER ( fact_clientes, fact_clientes[churn] = 0 && NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) ),
			        LOOKUPVALUE ( supuestos_escenario[costo_contacto], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] )
			            + LOOKUPVALUE ( supuestos_escenario[aceptacion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] ) * ( LOOKUPVALUE ( supuestos_escenario[incentivo_fijo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] ) + LOOKUPVALUE ( supuestos_escenario[incentivo_pct_cargo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], fact_clientes[palanca_id] ) * fact_clientes[cargo_mensual] )
			    )
		formatString: \$#,0
		displayFolder: 6. Simulador del programa
		lineageTag: e6e81f06-1dff-591a-a28e-f79925ce478b

	/// (Contribución salvada − costo) / costo, con los supuestos del escenario seleccionado.
	measure 'ROI Programa' = DIVIDE ( [Contribución Salvada] - [Costo Programa], [Costo Programa] )
		formatString: +0%;-0%;0%
		displayFolder: 6. Simulador del programa
		lineageTag: 08b3c679-f7e6-5989-8e52-d523d8197453

	/// Costo del programa por cliente salvado.
	measure 'Costo por Cliente Salvado' = DIVIDE ( [Costo Programa], [Clientes Salvados Esperados] )
		formatString: \$#,0
		displayFolder: 6. Simulador del programa
		lineageTag: f3126087-e8eb-50d5-9507-90f4d667ff3a

	/// ROI del programa aplicado solo a clientes activos de riesgo alto.
	measure 'ROI Focalizado Riesgo Alto' = CALCULATE ( [ROI Programa], fact_clientes[riesgo] = "Alto" )
		formatString: +0%;-0%;0%
		displayFolder: 6. Simulador del programa
		lineageTag: a897813a-ae1d-586e-ab58-96dabeeac41a

	/// ROI del programa aplicado a todos los clientes activos con palanca.
	measure 'ROI Sin Focalizar' = CALCULATE ( [ROI Programa], REMOVEFILTERS ( dim_riesgo ) )
		formatString: +0%;-0%;0%
		displayFolder: 6. Simulador del programa
		lineageTag: 140c24fd-c840-54c3-9d7d-8397524c8049

	/// Costo del programa focalizado.
	measure 'Costo Focalizado' = CALCULATE ( [Costo Programa], fact_clientes[riesgo] = "Alto" )
		formatString: \$#,0
		displayFolder: 6. Simulador del programa
		lineageTag: 85384f50-94ca-5501-890c-d076fba47dcf

	/// Contribución esperada del programa focalizado.
	measure 'Contribución Focalizada' = CALCULATE ( [Contribución Salvada], fact_clientes[riesgo] = "Alto" )
		formatString: \$#,0
		displayFolder: 6. Simulador del programa
		lineageTag: 2581ae74-914d-5b77-b951-2c1a3a4a1f0d

	/// Costo por cliente salvado del programa focalizado (guardrail: < USD 200).
	measure 'Costo Salvado Focalizado' = CALCULATE ( [Costo por Cliente Salvado], fact_clientes[riesgo] = "Alto" )
		formatString: \$#,0
		displayFolder: 6. Simulador del programa
		lineageTag: 34adba19-a4b3-576c-a7a3-d628d39422fc

	/// Regla de decisión según el ROI focalizado del escenario.
	measure 'Decisión Sugerida' =
			VAR roi = [ROI Focalizado Riesgo Alto]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( roi ), "Sin clientes objetivo en la selección",
			        roi >= 0, "ROI focalizado positivo en el escenario " & [Escenario Seleccionado] & ": ejecutar como piloto con grupo control",
			        "ROI negativo en el escenario " & [Escenario Seleccionado] & ": no escalar; revisar palancas y costos"
			    )
		displayFolder: 6. Simulador del programa
		lineageTag: 62e2bb23-f88e-5a93-9d6c-0c7a693107f2

	/// Verde si el ROI focalizado es ≥ 0.
	measure 'Color ROI Focalizado' = IF ( [ROI Focalizado Riesgo Alto] >= 0, "#138a3f", "#c8312f" )
		displayFolder: 6. Simulador del programa
		lineageTag: 234da65a-4ad7-5976-9d33-7dd5e46e3579

	/// Verde si el costo por cliente salvado es < USD 200.
	measure 'Color Costo Salvado' = IF ( [Costo Salvado Focalizado] < 200, "#138a3f", "#c8312f" )
		displayFolder: 6. Simulador del programa
		lineageTag: cb7ea1e9-cfd4-55dd-91d9-b779941d9f6c

	/// Contexto de la tarjeta de clientes de riesgo alto.
	measure 'Nota Riesgo Alto' = FORMAT ( DIVIDE ( [Clientes Riesgo Alto], [Clientes Activos] ), "0%" ) & " de los clientes activos"
		displayFolder: 6. Simulador del programa
		lineageTag: 340508e1-3002-5677-bfef-880bc7016bb4

	/// Contexto de la tarjeta de MRR de riesgo alto.
	measure 'Nota MRR Riesgo Alto' = FORMAT ( DIVIDE ( [MRR Riesgo Alto], [MRR Activo] ), "0%" ) & " del MRR activo"
		displayFolder: 6. Simulador del programa
		lineageTag: 60d9d7be-4476-563f-8196-df0ca09c2f6f

	/// Concentración del MRR en riesgo esperado en el nivel alto.
	measure 'Nota MRR Riesgo Esperado' = FORMAT ( DIVIDE ( CALCULATE ( [MRR en Riesgo Esperado], fact_clientes[riesgo] = "Alto" ), [MRR en Riesgo Esperado] ), "0%" ) & " está en riesgo alto"
		displayFolder: 6. Simulador del programa
		lineageTag: 4bd5a407-da0a-5e2e-826a-d51bc7bb01e5

	/// Comparación del ROI focalizado con el ROI sin focalizar.
	measure 'Nota ROI Focalizado' = "Sin focalizar: " & FORMAT ( [ROI Sin Focalizar], "+0%;-0%;0%" ) & " · escenario " & [Escenario Seleccionado]
		displayFolder: 6. Simulador del programa
		lineageTag: 05b97bbd-042c-5b93-839d-904e6a5bb350

	/// Contexto de la tarjeta de costo por cliente salvado.
	measure 'Nota Costo Salvado' = "Meta < USD 200 por cliente"
		displayFolder: 6. Simulador del programa
		lineageTag: a389af45-25a3-541c-af4a-95b06bfb1111

	/// Alternativa elegida (C1 = programa focalizado, por defecto).
	measure 'Alternativa Seleccionada' = SELECTEDVALUE ( dim_alternativa[alternativa_id], "C1" )
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: 3aec7a99-18c5-5aec-8a24-8de33ed8f945

	/// Nombre de la alternativa elegida.
	measure 'Nombre Alternativa' = SELECTEDVALUE ( dim_alternativa[alternativa], "C · Focalizado (riesgo alto)" )
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: dd6a3abb-7040-5049-b634-5e7dbd432b3b

	/// Reducción atribuible elegida en el parámetro; en blanco se usa la del escenario.
	measure 'Reducción Simulada' = SELECTEDVALUE ( sim_reduccion[reduccion] )
		formatString: 0%
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: 0b954ed4-8920-515a-b36a-4cd5f7fe157e

	/// Horizonte elegido en el parámetro; en blanco se usa el del escenario.
	measure 'Horizonte Simulado' = SELECTEDVALUE ( sim_horizonte[horizonte_meses] )
		formatString: 0
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: 98a6bd33-35e9-5736-8549-2e58fa9a29b5

	/// Clientes activos que recibe la alternativa elegida.
	measure 'Sim Clientes' =
			VAR alt = [Alternativa Seleccionada]
			RETURN
			    COUNTROWS ( FILTER (
			        fact_clientes,
			        fact_clientes[churn] = 0
			            && SWITCH (
			                alt,
			                "B", fact_clientes[contrato] = "Mes a mes",
			                "C0", NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ),
			                NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) && fact_clientes[riesgo] = "Alto"
			            )
			    ) )
		formatString: #,0
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: 239b646b-6370-57e3-bc77-20ed72c7dbbc

	/// Clientes que se espera salvar por corte con la alternativa y los supuestos elegidos.
	measure 'Sim Clientes Salvados' =
			VAR esc = [Escenario Seleccionado]
			VAR alt = [Alternativa Seleccionada]
			VAR rSel = [Reducción Simulada]
			VAR hSel = [Horizonte Simulado]
			RETURN
			    SUMX (
			        FILTER (
			        fact_clientes,
			        fact_clientes[churn] = 0
			            && SWITCH (
			                alt,
			                "B", fact_clientes[contrato] = "Mes a mes",
			                "C0", NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ),
			                NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) && fact_clientes[riesgo] = "Alto"
			            )
			    ),
			        VAR pal = IF ( alt = "B", "L1", fact_clientes[palanca_id] )
			        VAR acc = LOOKUPVALUE ( supuestos_escenario[aceptacion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR red = IF ( ISBLANK ( rSel ), LOOKUPVALUE ( supuestos_escenario[reduccion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), rSel )
			        VAR mar = LOOKUPVALUE ( supuestos_escenario[margen], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR hor = IF ( ISBLANK ( hSel ), LOOKUPVALUE ( supuestos_escenario[horizonte_meses], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), hSel )
			        VAR con = LOOKUPVALUE ( supuestos_escenario[costo_contacto], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR fij = LOOKUPVALUE ( supuestos_escenario[incentivo_fijo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR var_ = LOOKUPVALUE ( supuestos_escenario[incentivo_pct_cargo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        RETURN
			            fact_clientes[prob_churn] * acc * red
			    )
		formatString: #,0.0
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: 8f26ed3a-e234-5dd6-ac9b-1a010b9c7d73

	/// MRR mensual que se espera conservar.
	measure 'Sim MRR Salvado' =
			VAR esc = [Escenario Seleccionado]
			VAR alt = [Alternativa Seleccionada]
			VAR rSel = [Reducción Simulada]
			VAR hSel = [Horizonte Simulado]
			RETURN
			    SUMX (
			        FILTER (
			        fact_clientes,
			        fact_clientes[churn] = 0
			            && SWITCH (
			                alt,
			                "B", fact_clientes[contrato] = "Mes a mes",
			                "C0", NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ),
			                NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) && fact_clientes[riesgo] = "Alto"
			            )
			    ),
			        VAR pal = IF ( alt = "B", "L1", fact_clientes[palanca_id] )
			        VAR acc = LOOKUPVALUE ( supuestos_escenario[aceptacion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR red = IF ( ISBLANK ( rSel ), LOOKUPVALUE ( supuestos_escenario[reduccion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), rSel )
			        VAR mar = LOOKUPVALUE ( supuestos_escenario[margen], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR hor = IF ( ISBLANK ( hSel ), LOOKUPVALUE ( supuestos_escenario[horizonte_meses], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), hSel )
			        VAR con = LOOKUPVALUE ( supuestos_escenario[costo_contacto], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR fij = LOOKUPVALUE ( supuestos_escenario[incentivo_fijo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR var_ = LOOKUPVALUE ( supuestos_escenario[incentivo_pct_cargo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        RETURN
			            fact_clientes[prob_churn] * fact_clientes[cargo_mensual] * acc * red
			    )
		formatString: \$#,0
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: 9bccbc26-352c-5129-b1e9-f5daf8f7c0db

	/// MRR salvado × margen × horizonte.
	measure 'Sim Contribución' =
			VAR esc = [Escenario Seleccionado]
			VAR alt = [Alternativa Seleccionada]
			VAR rSel = [Reducción Simulada]
			VAR hSel = [Horizonte Simulado]
			RETURN
			    SUMX (
			        FILTER (
			        fact_clientes,
			        fact_clientes[churn] = 0
			            && SWITCH (
			                alt,
			                "B", fact_clientes[contrato] = "Mes a mes",
			                "C0", NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ),
			                NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) && fact_clientes[riesgo] = "Alto"
			            )
			    ),
			        VAR pal = IF ( alt = "B", "L1", fact_clientes[palanca_id] )
			        VAR acc = LOOKUPVALUE ( supuestos_escenario[aceptacion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR red = IF ( ISBLANK ( rSel ), LOOKUPVALUE ( supuestos_escenario[reduccion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), rSel )
			        VAR mar = LOOKUPVALUE ( supuestos_escenario[margen], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR hor = IF ( ISBLANK ( hSel ), LOOKUPVALUE ( supuestos_escenario[horizonte_meses], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), hSel )
			        VAR con = LOOKUPVALUE ( supuestos_escenario[costo_contacto], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR fij = LOOKUPVALUE ( supuestos_escenario[incentivo_fijo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR var_ = LOOKUPVALUE ( supuestos_escenario[incentivo_pct_cargo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        RETURN
			            fact_clientes[prob_churn] * fact_clientes[cargo_mensual] * acc * red * mar * hor
			    )
		formatString: \$#,0
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: e8c0df61-96c2-5e89-9638-149c20aed913

	/// Costo de contacto + aceptación × incentivo.
	measure 'Sim Costo' =
			VAR esc = [Escenario Seleccionado]
			VAR alt = [Alternativa Seleccionada]
			VAR rSel = [Reducción Simulada]
			VAR hSel = [Horizonte Simulado]
			RETURN
			    SUMX (
			        FILTER (
			        fact_clientes,
			        fact_clientes[churn] = 0
			            && SWITCH (
			                alt,
			                "B", fact_clientes[contrato] = "Mes a mes",
			                "C0", NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ),
			                NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) && fact_clientes[riesgo] = "Alto"
			            )
			    ),
			        VAR pal = IF ( alt = "B", "L1", fact_clientes[palanca_id] )
			        VAR acc = LOOKUPVALUE ( supuestos_escenario[aceptacion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR red = IF ( ISBLANK ( rSel ), LOOKUPVALUE ( supuestos_escenario[reduccion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), rSel )
			        VAR mar = LOOKUPVALUE ( supuestos_escenario[margen], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR hor = IF ( ISBLANK ( hSel ), LOOKUPVALUE ( supuestos_escenario[horizonte_meses], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), hSel )
			        VAR con = LOOKUPVALUE ( supuestos_escenario[costo_contacto], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR fij = LOOKUPVALUE ( supuestos_escenario[incentivo_fijo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        VAR var_ = LOOKUPVALUE ( supuestos_escenario[incentivo_pct_cargo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			        RETURN
			            con + acc * ( fij + var_ * fact_clientes[cargo_mensual] )
			    )
		formatString: \$#,0
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: 1d752493-0b79-5aca-8a58-655ec60274df

	/// ROI de la alternativa con los supuestos elegidos.
	measure 'Sim ROI' = DIVIDE ( [Sim Contribución] - [Sim Costo], [Sim Costo] )
		formatString: +0%;-0%;0%
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: aa547ce2-862c-5475-a77d-526fd781d416

	/// Contribución − costo (USD).
	measure 'Sim Resultado Neto' = [Sim Contribución] - [Sim Costo]
		formatString: \$#,0;-\$#,0
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: 1f913882-d8c6-5e79-8ff7-28c85aa884fc

	/// Costo por cliente salvado.
	measure 'Sim Costo por Salvado' = DIVIDE ( [Sim Costo], [Sim Clientes Salvados] )
		formatString: \$#,0
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: dadb1c9e-fd8c-5954-89ad-945cb9cdc5e3

	/// Reducción atribuible mínima para que la alternativa no pierda dinero (ROI = 0).
	measure 'Reducción de Equilibrio' =
			VAR k =
			    VAR esc = [Escenario Seleccionado]
			    VAR alt = [Alternativa Seleccionada]
			    VAR rSel = BLANK ()
			    VAR hSel = [Horizonte Simulado]
			    RETURN
			        SUMX (
			            FILTER (
			            fact_clientes,
			            fact_clientes[churn] = 0
			                && SWITCH (
			                    alt,
			                    "B", fact_clientes[contrato] = "Mes a mes",
			                    "C0", NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ),
			                    NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) && fact_clientes[riesgo] = "Alto"
			                )
			        ),
			            VAR pal = IF ( alt = "B", "L1", fact_clientes[palanca_id] )
			            VAR acc = LOOKUPVALUE ( supuestos_escenario[aceptacion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			            VAR red = IF ( ISBLANK ( rSel ), LOOKUPVALUE ( supuestos_escenario[reduccion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), rSel )
			            VAR mar = LOOKUPVALUE ( supuestos_escenario[margen], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			            VAR hor = IF ( ISBLANK ( hSel ), LOOKUPVALUE ( supuestos_escenario[horizonte_meses], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), hSel )
			            VAR con = LOOKUPVALUE ( supuestos_escenario[costo_contacto], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			            VAR fij = LOOKUPVALUE ( supuestos_escenario[incentivo_fijo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			            VAR var_ = LOOKUPVALUE ( supuestos_escenario[incentivo_pct_cargo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			            RETURN
			                fact_clientes[prob_churn] * fact_clientes[cargo_mensual] * acc * mar * hor
			        )
			RETURN
			    DIVIDE ( [Sim Costo], k )
		formatString: 0.0%
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: b468eb9f-2516-5be7-af0c-be84abb195a4

	/// ROI de la alternativa para cada valor del eje de reducción atribuible.
	measure 'ROI Curva' =
			VAR contribucion =
			    VAR esc = [Escenario Seleccionado]
			    VAR alt = [Alternativa Seleccionada]
			    VAR rSel = MAX ( eje_reduccion[reduccion_eje] )
			    VAR hSel = [Horizonte Simulado]
			    RETURN
			        SUMX (
			            FILTER (
			            fact_clientes,
			            fact_clientes[churn] = 0
			                && SWITCH (
			                    alt,
			                    "B", fact_clientes[contrato] = "Mes a mes",
			                    "C0", NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ),
			                    NOT ( fact_clientes[palanca_id] IN { "L0", "NA" } ) && fact_clientes[riesgo] = "Alto"
			                )
			        ),
			            VAR pal = IF ( alt = "B", "L1", fact_clientes[palanca_id] )
			            VAR acc = LOOKUPVALUE ( supuestos_escenario[aceptacion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			            VAR red = IF ( ISBLANK ( rSel ), LOOKUPVALUE ( supuestos_escenario[reduccion], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), rSel )
			            VAR mar = LOOKUPVALUE ( supuestos_escenario[margen], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			            VAR hor = IF ( ISBLANK ( hSel ), LOOKUPVALUE ( supuestos_escenario[horizonte_meses], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal ), hSel )
			            VAR con = LOOKUPVALUE ( supuestos_escenario[costo_contacto], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			            VAR fij = LOOKUPVALUE ( supuestos_escenario[incentivo_fijo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			            VAR var_ = LOOKUPVALUE ( supuestos_escenario[incentivo_pct_cargo], supuestos_escenario[escenario], esc, supuestos_escenario[palanca_id], pal )
			            RETURN
			                fact_clientes[prob_churn] * fact_clientes[cargo_mensual] * acc * red * mar * hor
			        )
			RETURN
			    DIVIDE ( contribucion - [Sim Costo], [Sim Costo] )
		formatString: +0%;-0%;0%
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: 66a7ac00-f48e-578f-a89c-c4c5fad8588c

	/// Línea de equilibrio (ROI = 0).
	measure 'ROI Cero' = 0
		formatString: 0%
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: 36804a16-5722-54cb-8967-c4dad4bbeccf

	/// Verde si el ROI simulado es ≥ 0.
	measure 'Color ROI Simulado' = IF ( [Sim ROI] >= 0, "#138a3f", "#c8312f" )
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: bc96363f-b692-52b6-b99c-864b9b1ba497

	/// Lectura breve del ROI simulado.
	measure 'Nota Sim ROI' = IF ( [Sim ROI] >= 0, "Rentable con estos supuestos", "Pierde dinero con estos supuestos" )
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: a443dedc-0bf9-55bd-a12d-76c2a2cc2ee0

	/// Lectura automática del resultado del simulador.
	measure 'Lectura Simulador' =
			VAR roi = [Sim ROI]
			RETURN
			    [Nombre Alternativa] & " · escenario " & [Escenario Seleccionado] & ": se intervienen "
			        & FORMAT ( [Sim Clientes], "#,0" ) & " clientes, se salvan " & FORMAT ( [Sim Clientes Salvados], "0.0" )
			        & " por corte y el ROI es " & FORMAT ( roi, "+0%;-0%;0%" ) & ". "
			        & IF ( roi >= 0, "Resultado positivo: candidato a piloto con grupo control. ", "Resultado negativo: no ejecutar con estos supuestos. " )
			        & "Para no perder dinero, la reducción atribuible debe superar " & FORMAT ( [Reducción de Equilibrio], "0.0%" ) & "."
		displayFolder: 7. Simulador qué pasaría si
		lineageTag: c6ce240e-049d-5367-b92a-68b22059086d

	column Orden
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: c990426f-7eb5-553d-ad5a-501b0061bf9d
