	partition dim_palanca = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "dim_palanca.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"palanca_id", type text}, {"palanca", type text}, {"descripcion", type text}, {"responsable", type text}, {"esfuerzo", type text}, {"orden", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
