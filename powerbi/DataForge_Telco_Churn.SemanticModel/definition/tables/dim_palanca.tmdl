/// Palancas de retención y su responsable.
table dim_palanca
	lineageTag: fcbdf368-b788-5079-a350-7b5c5adc3d7c

	column palanca_id
		dataType: string
		lineageTag: 0a1f83fc-1fd7-5647-a188-4c1a3f9c2846
		summarizeBy: none
		sourceColumn: palanca_id

		annotation SummarizationSetBy = User

	column palanca
		dataType: string
		lineageTag: 4822d335-2f07-5e46-9467-fc6a876f1234
		summarizeBy: none
		sourceColumn: palanca
		sortByColumn: orden

		annotation SummarizationSetBy = User

	column descripcion
		dataType: string
		lineageTag: 8b26e523-feea-558b-8ad3-869988153451
		summarizeBy: none
		sourceColumn: descripcion

		annotation SummarizationSetBy = User

	column responsable
		dataType: string
		lineageTag: 5a7f9da6-382a-5c1d-887c-a18bda7ce983
		summarizeBy: none
		sourceColumn: responsable

		annotation SummarizationSetBy = User

	column esfuerzo
		dataType: string
