				    Tipos = Table.TransformColumnTypes(Encabezados, {{"escenario", type text}, {"escenario_orden", Int64.Type}, {"palanca_id", type text}, {"aceptacion", type number}, {"reduccion", type number}, {"margen", type number}, {"horizonte_meses", Int64.Type}, {"costo_contacto", type number}, {"incentivo_fijo", type number}, {"incentivo_pct_cargo", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
