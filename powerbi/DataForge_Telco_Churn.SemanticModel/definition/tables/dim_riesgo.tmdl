/// Nivel de riesgo según el score fuera de muestra.
table dim_riesgo
	lineageTag: 0c7997d0-c2cd-50aa-92db-6c994eebe86b

	column riesgo
		dataType: string
		lineageTag: 964faa42-8fbc-5c85-8229-29c8fd939e02
		summarizeBy: none
		sourceColumn: riesgo
		sortByColumn: riesgo_orden

		annotation SummarizationSetBy = User

	column riesgo_orden
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: f727116b-6864-5611-b10d-fdce28ce1bcb
		summarizeBy: none
		sourceColumn: riesgo_orden

		annotation SummarizationSetBy = User

	column definicion
		dataType: string
		lineageTag: 9a43d3c2-3708-594e-8f2f-9b65a776d502
		summarizeBy: none
		sourceColumn: definicion

		annotation SummarizationSetBy = User

	partition dim_riesgo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "dim_riesgo.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"riesgo", type text}, {"riesgo_orden", Int64.Type}, {"definicion", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
