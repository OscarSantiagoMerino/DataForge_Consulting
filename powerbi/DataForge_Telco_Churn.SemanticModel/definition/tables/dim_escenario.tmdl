/// Escenarios del simulador (tabla desconectada).
table dim_escenario
	lineageTag: d8a828fc-314e-54b7-bf56-03b6723195c2

	column escenario
		dataType: string
		lineageTag: b4719192-033c-57f1-947f-8cb0ffa8d25e
		summarizeBy: none
		sourceColumn: escenario
		sortByColumn: escenario_orden

		annotation SummarizationSetBy = User

	column escenario_orden
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: c3fdd4ad-6a51-573c-9ba0-5f6127801140
		summarizeBy: none
		sourceColumn: escenario_orden

		annotation SummarizationSetBy = User

	partition dim_escenario = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "dim_escenario.csv"), [Delimiter = ",", Columns = 2, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"escenario", type text}, {"escenario_orden", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
