	partition dim_antiguedad = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "dim_antiguedad.csv"), [Delimiter = ",", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"antiguedad_meses", Int64.Type}, {"banda_antiguedad", type text}, {"banda_orden", Int64.Type}, {"etapa_ciclo_vida", type text}, {"etapa_orden", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
