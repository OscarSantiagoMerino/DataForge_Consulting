/// Meses de antigüedad 0–72 con su banda y etapa de ciclo de vida.
table dim_antiguedad
	lineageTag: 892dc2cc-afc3-528f-b8cc-a519ac3d37ac

	column antiguedad_meses
		dataType: int64
		formatString: 0
		lineageTag: 7b303348-b1af-58f1-9441-78791fe27c3e
		summarizeBy: none
		sourceColumn: antiguedad_meses

		annotation SummarizationSetBy = User

	column banda_antiguedad
		dataType: string
		lineageTag: da10fc88-d812-5784-b0ef-038ca90d0cd4
		summarizeBy: none
		sourceColumn: banda_antiguedad
		sortByColumn: banda_orden

