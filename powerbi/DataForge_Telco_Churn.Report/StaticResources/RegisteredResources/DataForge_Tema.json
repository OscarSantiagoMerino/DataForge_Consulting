{
  "name": "DataForge Consulting",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#6250d6",
    "#e34948"
  ],
  "background": "#ffffff",
  "foreground": "#1b1f24",
  "tableAccent": "#13294b",
  "good": "#138a3f",
  "neutral": "#fab219",
  "bad": "#c8312f",
  "maximum": "#1c5cab",
  "center": "#86b6ef",
  "minimum": "#cde2fb",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#1b1f24"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1b1f24"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1b1f24"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5b6573"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#dde3ea"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5b6573"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5b6573"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#edf0f3"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#5b6573"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#eef1f5"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#eef1f5"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#e8ecf1"
              }
            },
            "rowPadding": 3,
            "outlineColor": {
              "solid": {
                "color": "#dde3ea"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "backColor": {
              "solid": {
                "color": "#13294b"
              }
            },
            "fontSize": 9,
            "bold": true,
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1b1f24"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1b1f24"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#f5f7fa"
              }
            },
            "fontSize": 9
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#1b1f24"
              }
            },
            "backColor": {
              "solid": {
                "color": "#e8eef6"
              }
            },
            "bold": true
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#e8ecf1"
              }
            },
            "rowPadding": 2
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "backColor": {
              "solid": {
                "color": "#13294b"
              }
            },
            "fontSize": 10,
            "bold": true
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1b1f24"
              }
            },
            "backColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1b1f24"
              }
            },
            "fontSize": 10
          }
        ],
        "total": [
          {
            "backColor": {
              "solid": {
                "color": "#e8eef6"
              }
            },
            "bold": true
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#5b6573"
              }
            },
            "fontSize": 9,
            "bold": true
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1b1f24"
              }
            },
            "fontSize": 10,
            "background": {
              "solid": {
                "color": "#f5f7fa"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1b1f24"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            }
          }
        ]
      }
    }
  }
}